{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>lgtm-hq/.github:renovate-config"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^vendors\\.yaml$/"
      ],
      "matchStrings": [
        "repo:\\s*(?<depName>[^\\s]+)\\s+sha:\\s*[\"']?(?<currentDigest>[0-9a-f]{40})[\"']?"
      ],
      "datasourceTemplate": "git-refs",
      "currentValueTemplate": "HEAD",
      "packageNameTemplate": "https://github.com/{{{depName}}}"
    }
  ],
  "packageRules": [
    {
      "description": "lintro PyPI pin must stay lockstep with ghcr.io/lgtm-hq/py-lintro digests in ci.yml and validate-lintro-version.yml. Solo Renovate bumps re-break Validate Lintro Version when the GHCR tag is missing.",
      "matchPackageNames": [
        "lintro"
      ],
      "enabled": false
    }
  ]
}
