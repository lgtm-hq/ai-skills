{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>lgtm-hq/.github:renovate-config"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^vendors\\.yaml$/"
      ],
      "matchStrings": [
        "repo:\\s*(?<depName>[^\\s]+)\\s+sha:\\s*[\"']?(?<currentDigest>[0-9a-f]{40})[\"']?"
      ],
      "datasourceTemplate": "git-refs",
      "currentValueTemplate": "HEAD",
      "packageNameTemplate": "https://github.com/{{{depName}}}"
    }
  ],
  "packageRules": [
    {
      "description": "Disable solo lintro bumps — pin must stay lockstep with ghcr.io/lgtm-hq/py-lintro digests in ci.yml / validate-lintro-version.yml.",
      "matchPackageNames": [
        "lintro"
      ],
      "enabled": false
    },
    {
      "description": "Re-enable lintro vulnerability alerts only (GHCR digests must be updated in the same change).",
      "matchPackageNames": [
        "lintro"
      ],
      "vulnerabilityAlerts": {
        "enabled": true
      }
    }
  ]
}
