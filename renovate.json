{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>lgtm-hq/.github:renovate-config"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Track the shared uv and Bun installer versions",
      "managerFilePatterns": [
        "/^scripts/tool-versions\\.sh$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[^\\s]+) depName=(?<depName>[^\\s]+)(?: extractVersion=(?<extractVersion>[^\\s]+))?\\s+(?:UV|BUN)_VERSION=\"(?<currentValue>[^\"]+)\""
      ]
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^vendors\\.yaml$/"
      ],
      "matchStrings": [
        "repo:\\s*(?<depName>[^\\s]+)\\s+sha:\\s*[\"']?(?<currentDigest>[0-9a-f]{40})[\"']?\\s+branch:\\s*[\"']?(?<currentValue>[^\\s\"']+)[\"']?(?:[ \t]+#[^\\r\\n]*)?[ \t]*(?:\\r?\\n|$)"
      ],
      "datasourceTemplate": "git-refs",
      "packageNameTemplate": "https://github.com/{{{depName}}}"
    },
    {
      "customType": "regex",
      "description": "Track pinned py-lintro Docker image digests so org lintro grouping can move pin + image together",
      "managerFilePatterns": [
        "/^\\.github/workflows/ci\\.yml$/",
        "/^\\.github/workflows/validate-lintro-version\\.yml$/"
      ],
      "matchStrings": [
        "ghcr\\.io/lgtm-hq/py-lintro@(?<currentDigest>sha256:[a-f0-9]+)"
      ],
      "depNameTemplate": "ghcr.io/lgtm-hq/py-lintro",
      "currentValueTemplate": "latest",
      "datasourceTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "description": "Require reviewed installer checksums alongside version updates",
      "matchManagers": ["custom.regex"],
      "matchPackageNames": [
        "astral-sh/uv",
        "oven-sh/bun"
      ],
      "prBodyNotes": [
        "Update the matching installer SHA-256 in `scripts/tool-versions.sh` after reviewing the pinned upstream installer. Run `bash scripts/ci/check-tool-installers.sh` to verify the hashes (mismatches fail closed). See CONTRIBUTING.md for the digest measurement and refresh commands."
      ]
    },
    {
      "description": "Keep pyproject lintro pin and workflow py-lintro digests in one PR (org preset also groups these; local rule documents the lockstep).",
      "groupName": "lintro",
      "groupSlug": "lintro",
      "matchPackageNames": [
        "ghcr.io/lgtm-hq/py-lintro",
        "lintro"
      ]
    }
  ],
  "gitIgnoredAuthors": [
    "273006376+lgtm-release-bot[bot]@users.noreply.github.com"
  ]
}
