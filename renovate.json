{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>lgtm-hq/.github:renovate-config"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^vendors\\.yaml$/"
      ],
      "matchStrings": [
        "repo:\\s*(?<depName>[^\\s]+)\\s+sha:\\s*[\"']?(?<currentDigest>[0-9a-f]{40})[\"']?"
      ],
      "datasourceTemplate": "git-refs",
      "currentValueTemplate": "HEAD",
      "packageNameTemplate": "https://github.com/{{{depName}}}"
    },
    {
      "customType": "regex",
      "description": "Track pinned py-lintro Docker image digests so org lintro grouping can move pin + image together",
      "managerFilePatterns": [
        "/^\\.github/workflows/ci\\.yml$/",
        "/^\\.github/workflows/validate-lintro-version\\.yml$/"
      ],
      "matchStrings": [
        "ghcr\\.io/lgtm-hq/py-lintro@(?<currentDigest>sha256:[a-f0-9]+)"
      ],
      "depNameTemplate": "ghcr.io/lgtm-hq/py-lintro",
      "currentValueTemplate": "latest",
      "datasourceTemplate": "docker"
    }
  ]
}
