{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>lgtm-hq/.github:renovate-config"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^vendors\\.yaml$/"
      ],
      "matchStrings": [
        "repo:\\s*(?<depName>[^\\s]+)\\s+sha:\\s*[\"']?(?<currentDigest>[0-9a-f]{40})[\"']?"
      ],
      "datasourceTemplate": "git-refs",
      "currentValueTemplate": "HEAD",
      "packageNameTemplate": "https://github.com/{{{depName}}}"
    }
  ],
  "packageRules": [
    {
      "description": "Block solo lintro version bumps — pin must stay lockstep with ghcr.io/lgtm-hq/py-lintro digests in ci.yml / validate-lintro-version.yml. Vulnerability alerts stay enabled so security releases still surface.",
      "matchPackageNames": [
        "lintro"
      ],
      "matchUpdateTypes": [
        "major",
        "minor",
        "patch",
        "pin",
        "pinDigest",
        "rollback",
        "bump",
        "replacement"
      ],
      "enabled": false
    }
  ]
}
