{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "rewriteRelativeImportExtensions": true,
    "resolveJsonModule": true,
    "types": ["bun-types"],
    "outDir": "dist",
    "rootDir": "."
  },
  "include": ["bin", "lib", "test", "scripts"]
}
