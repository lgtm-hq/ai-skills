{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-skills.dev/schemas/ai-skills.v1.schema.json",
  "title": "ai-skills manifest v1",
  "type": "object",
  "properties": {
    "apiVersion": {
      "const": "ai-skills.dev/v1"
    },
    "publisher": {
      "$ref": "#/$defs/publisher"
    },
    "packages": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/package"
      }
    },
    "vendors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/vendor"
      }
    },
    "exports": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "policy": {
      "$ref": "#/$defs/policy"
    },
    "overrides": {
      "$ref": "#/$defs/overrides"
    }
  },
  "required": ["apiVersion", "publisher"],
  "patternProperties": {
    "^x-": {}
  },
  "additionalProperties": false,
  "$defs": {
    "publisher": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "repo": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["id"],
      "patternProperties": {
        "^x-": {}
      },
      "additionalProperties": false
    },
    "capability": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "$ref": "#/$defs/role"
        },
        "requires": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "related": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "resources": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": ["id", "path"],
      "patternProperties": {
        "^x-": {}
      },
      "additionalProperties": false
    },
    "resource": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "path": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["id", "path"],
      "patternProperties": {
        "^x-": {}
      },
      "additionalProperties": false
    },
    "package": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "capabilities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/capability"
          }
        },
        "resources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/resource"
          }
        },
        "include": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "exclude": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "artifactResources": {
          "$ref": "#/$defs/artifactResources"
        }
      },
      "required": ["id"],
      "patternProperties": {
        "^x-": {}
      },
      "additionalProperties": false
    },
    "mappedCapability": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "requires": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "related": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "resources": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [],
      "patternProperties": {
        "^x-": {}
      },
      "additionalProperties": false
    },
    "mappedPackage": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "description": {
          "type": "string"
        },
        "skillsRoot": {
          "type": "string",
          "minLength": 1
        },
        "skills": {
          "oneOf": [
            {
              "const": "*"
            },
            {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          ]
        },
        "extraSkills": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "extraFiles": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "renameSkills": {
          "type": "object",
          "patternProperties": {
            "^[a-z0-9]+(?:-[a-z0-9]+)*$": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "agents": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        },
        "capabilities": {
          "type": "object",
          "patternProperties": {
            "^[a-z0-9]+(?:-[a-z0-9]+)*$": {
              "$ref": "#/$defs/mappedCapability"
            }
          },
          "additionalProperties": false
        },
        "artifactResources": {
          "$ref": "#/$defs/artifactResources"
        }
      },
      "required": ["id", "skillsRoot", "skills"],
      "patternProperties": {
        "^x-": {}
      },
      "additionalProperties": false
    },
    "mapping": {
      "type": "object",
      "properties": {
        "skillRoots": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "packages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/mappedPackage"
          }
        }
      },
      "required": ["skillRoots"],
      "patternProperties": {
        "^x-": {}
      },
      "additionalProperties": false
    },
    "vendor": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "repo": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "sha": {
          "description": "YAML source must be a direct, unescaped 40-hex scalar (plain or ordinary single/double quoted), without escape sequences, folded/block scalars, anchors, aliases or tags. Enforced by the manifest loader before compatibility publication so native Renovate can update one pin safely.",
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "branch": {
          "type": "string",
          "minLength": 1
        },
        "displayRef": {
          "type": "string",
          "minLength": 1
        },
        "license": {
          "type": "string",
          "minLength": 1
        },
        "homepage": {
          "type": "string",
          "minLength": 1
        },
        "mapping": {
          "$ref": "#/$defs/mapping"
        },
        "include": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "exclude": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "ingestAllow": {
          "$ref": "#/$defs/ingestAllow"
        },
        "ingestLimits": {
          "$ref": "#/$defs/ingestLimits"
        }
      },
      "required": ["id", "repo", "sha"],
      "patternProperties": {
        "^x-": {}
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "properties": {
        "mode": {
          "enum": ["strict", "warn"]
        },
        "acceptAttestations": {
          "type": "boolean"
        }
      },
      "required": ["mode"],
      "patternProperties": {
        "^x-": {}
      },
      "additionalProperties": false
    },
    "deny": {
      "type": "object",
      "properties": {
        "origins": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [],
      "patternProperties": {
        "^x-": {}
      },
      "additionalProperties": false
    },
    "policy": {
      "type": "object",
      "properties": {
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "deny": {
          "$ref": "#/$defs/deny"
        },
        "roles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/role"
          }
        },
        "modes": {
          "type": "object",
          "patternProperties": {
            "^[a-z0-9]+(?:-[a-z0-9]+)*$": {
              "$ref": "#/$defs/mode"
            }
          },
          "additionalProperties": false
        },
        "transports": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/transport"
          }
        }
      },
      "required": [],
      "patternProperties": {
        "^x-": {}
      },
      "additionalProperties": false
    },
    "migration": {
      "type": "object",
      "properties": {
        "from": {
          "type": "string",
          "minLength": 1
        },
        "to": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["from", "to"],
      "patternProperties": {
        "^x-": {}
      },
      "additionalProperties": false
    },
    "attestation": {
      "type": "object",
      "properties": {
        "capability": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "independentlyAuthored": {
          "const": true
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["capability", "path", "independentlyAuthored", "reason"],
      "patternProperties": {
        "^x-": {}
      },
      "additionalProperties": false
    },
    "collision": {
      "type": "object",
      "properties": {
        "capability": {
          "type": "string",
          "minLength": 1
        },
        "action": {
          "enum": ["keep", "rename", "skip"]
        },
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        }
      },
      "required": ["capability", "action"],
      "patternProperties": {
        "^x-": {}
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "action": {
                "const": "rename"
              }
            }
          },
          "then": {
            "required": ["name"]
          }
        }
      ]
    },
    "overrides": {
      "type": "object",
      "properties": {
        "migrations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/migration"
          }
        },
        "attestations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/attestation"
          }
        },
        "collisions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/collision"
          }
        },
        "ingestAllow": {
          "$ref": "#/$defs/ingestAllow"
        }
      },
      "required": [],
      "patternProperties": {
        "^x-": {}
      },
      "additionalProperties": false
    },
    "role": {
      "enum": [
        "skill",
        "instruction",
        "specialist",
        "workflow",
        "lifecycle",
        "integration"
      ]
    },
    "mode": {
      "enum": ["native-plugin", "user-explode", "repo-materialize"]
    },
    "transport": {
      "enum": ["npm", "release-asset", "git-marketplace", "offline"]
    },
    "ingestAllow": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)(?:\\.{1,2})?(?:/|$))[^\\u0000]+$"
          },
          "rule": {
            "enum": [
              "pem-private-key",
              "aws-access-key-id",
              "github-token",
              "slack-token",
              "google-api-key",
              "npm-token",
              "stripe-live-key",
              "anthropic-api-key",
              "openai-project-key"
            ]
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "reason": {
            "type": "string",
            "pattern": "\\S"
          }
        },
        "required": ["path", "rule", "sha256", "reason"],
        "additionalProperties": false
      }
    },
    "ingestLimits": {
      "type": "object",
      "properties": {
        "downloadBytes": {
          "type": "integer",
          "minimum": 1
        },
        "archiveMembers": {
          "type": "integer",
          "minimum": 1
        },
        "archiveBytes": {
          "type": "integer",
          "minimum": 1
        },
        "memberBytes": {
          "type": "integer",
          "minimum": 1
        },
        "compressionRatio": {
          "type": "integer",
          "minimum": 1
        },
        "fileBytes": {
          "type": "integer",
          "minimum": 1
        },
        "pluginBytes": {
          "type": "integer",
          "minimum": 1
        },
        "reason": {
          "type": "string",
          "pattern": "\\S"
        }
      },
      "required": ["reason"],
      "minProperties": 2,
      "additionalProperties": false
    },
    "artifactResources": {
      "description": "Version 1 artifact-only resource projection. Legacy registries and plugins-baked explicitly ignore it and do not deliver these dependencies. Each role/name binding must enumerate the complete transitive resource ID closure; structural references must resolve within that closure or the capability. Ordinary dependency-loss rejection is unchanged.",
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "resources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/resource"
          }
        },
        "bindings": {
          "type": "object",
          "minProperties": 1,
          "patternProperties": {
            "^(?:skill|instruction|specialist|workflow|lifecycle|integration)/[a-z0-9]+(?:-[a-z0-9]+)*$": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
              }
            }
          },
          "additionalProperties": false
        }
      },
      "required": ["version", "resources", "bindings"],
      "patternProperties": {
        "^x-": {}
      },
      "additionalProperties": false
    }
  }
}
